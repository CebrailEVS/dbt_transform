# dbt artifacts
target/
dbt_packages/
logs/


# Environment & secrets
.env
.env.*
!.env.example
dbt_venv/

# Python
__pycache__/
*.py[cod]

# IDE & OS
.vscode/
.DS_Store

# Claude Code — la couche IA partagee est versionnee (CLAUDE.md, .mcp.json,
# .claude/commands/, .claude/skills/, .claude/hooks/, .claude/settings.json).
# On garde hors git uniquement les reglages perso et les notes de travail :
.claude/settings.local.json
.claude/notes/

# Keyfile test
keyfile.b64.txt
keyfile.json
*-keyfile.json
*-sa-key.json

# Brouillon local (tests, exports, rapports ponctuels) : tmp/, jamais versionné.
# scripts/ ne contient QUE des scripts d'équipe, tous versionnés.
tmp/

# Modèles d'analyse ad hoc / jetables (comparaisons vs prod, dev-only).
# Non versionnés : ils tournent en local à la demande, hors CI.
models/_analysis/

# Manifest de prod pour --defer (scripts/pull-state.sh), jamais versionné
state/

# Identifiant anonyme local de dbt
.user.yml
dbt_internal_packages/
