# Configuration de `dbt lint` (natif dbt v2, mêmes clés et codes de règles que SQLFluff).
# Règles résumées dans CONVENTIONS.md § Lint SQL.
[sqlfluff]
dialect = bigquery
# Seule valeur acceptée sans avertissement par dbt lint.
templater = dbt
max_line_length = 120
exclude_rules = ST06

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

# functions et types prennent extended_capitalisation_policy : avec
# capitalisation_policy, la règle est ignorée sans message.
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Pas de virgule après la dernière colonne d'un select.
[sqlfluff:rules:convention.select_trailing_comma]
select_clause_trailing_comma = forbid

[sqlfluff:rules:convention.casting_style]
preferred_type_casting_style = consistent
