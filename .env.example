# Cible dbt — toujours `dev` en local. `prod` est reserve a Cloud Run et au job cd.
DBT_TARGET=dev

# --- Projet GCP unique (dev et prod) ---
DBT_BIGQUERY_PROJECT=evs-datastack-prod

# --- Target dev : ton dataset personnel, SA dbt-dev (infra/dbt_environments.tf) ---
# dbt-dev ecrit uniquement dans dbt_<toi> et dev_raw ; il LIT prod_*, n'y ecrit jamais.
# Cle generee a la main, gardee hors repo en chmod 600.
DBT_BIGQUERY_KEYFILE_DEV=/opt/credentials/gcp-dbt-dev-prod-key.json
DBT_BIGQUERY_DATASET_DEV=dbt_<toi>

# --- Defer par defaut vers la prod ---
# Les ref() non construits en local pointent vers prod_*. state/ est rempli par
# scripts/pull-state.sh (a relancer apres un merge sur master).
DBT_DEFER=true
DBT_STATE=state/
DBT_STATE_BUCKET=evs-datastack-dbt-state

# --- Target prod : lu par Cloud Run, pas en local ---
DBT_BIGQUERY_KEYFILE=/chemin/vers/prod-keyfile.json
DBT_BIGQUERY_DATASET_PROD=prod
