# Cible dbt — toujours `dev` en local. `prod` est reserve aux Cloud Run Jobs.
DBT_TARGET=dev

# --- Target dev : projet GCP DEDIE (isolation depuis PR #165) ---
# Les modeles se materialisent ici ; les sources restent lues dans prod_raw
# en cross-project via var('raw_project').
DBT_BIGQUERY_PROJECT_DEV=evs-datastack-dev
DBT_BIGQUERY_KEYFILE_DEV=/chemin/vers/dbt-dev-keyfile.json
DBT_BIGQUERY_DATASET_DEV=dev

# --- Target prod : lu par les Cloud Run Jobs, pas en local ---
DBT_BIGQUERY_PROJECT=evs-datastack-prod
DBT_BIGQUERY_KEYFILE=/chemin/vers/prod-keyfile.json
DBT_BIGQUERY_DATASET_PROD=prod
